# Lotus workers. Names only; real values come from the host's secret store, never from a committed file.
DATABASE_URL=
# Optional: direct (non-pooler) connection used only for the prize-sender lock, e.g. postgresql://postgres:PASSWORD@db.<ref>.supabase.co:5432/postgres
DATABASE_LOCK_URL=
# Helius devnet RPC URL (also serves DAS). e.g. https://devnet.helius-rpc.com/?api-key=...
SOLANA_RPC_URL=
# Optional, defaults to SOLANA_RPC_URL
HELIUS_DAS_URL=
# Optional: Squads vault address (the vault, not the multisig account). Read-only; lets inventory sync check vault cards.
SQUADS_VAULT_ADDRESS=
# Hot wallet secret key (base58 or solana-keygen JSON array). Secret store only.
HOT_WALLET_SECRET_KEY=
# Leave unset. Mainnet is refused unless this equals the phrase in src/config.ts, set by a human at go-live.
LOTUS_ALLOW_MAINNET=
# Comma-separated Collector Crypt collection addresses counted as prize inventory (empty = all NFTs in the hot wallet)
PRIZE_COLLECTIONS=
PRIZE_SENDER_INTERVAL_MS=5000
PRIZE_SENDER_BATCH=10
PRIZE_SENDER_MAX_ATTEMPTS=8
INVENTORY_SYNC_INTERVAL_MS=120000
# World crate seeder: how often it tops the launch cities up. It needs only the database.
CRATE_SEED_INTERVAL_MS=300000
# Location pings older than this many days are deleted hourly.
PING_RETENTION_DAYS=30
PRIORITY_FEE_MICROLAMPORTS=10000

# --- Treasury (all optional; each job turns on only when its keys are set) ---
# Top-up proposer: drafts Squads proposals that move vault cards (and SOL) to the hot wallet.
# The proposer must be a multisig member with the Initiate permission ONLY; the worker refuses otherwise.
SQUADS_MULTISIG_ADDRESS=
SQUADS_PROPOSER_SECRET_KEY=
# The worker also refuses a multisig with a config authority or a threshold below this.
SQUADS_MIN_THRESHOLD=2
# Only for a deliberately single-signer safe (SQUADS_MIN_THRESHOLD=1): yes-one-wallet-controls-the-vault
SQUADS_ALLOW_SINGLE_SIGNER=
TOPUP_TARGETS=common:10,uncommon:4,rare:2,grail:1
TOPUP_MAX_CARDS=10
TOPUP_MAX_USD=500
TOPUP_MIN_HOT_SOL=0.05
TOPUP_SOL_AMOUNT=0.1
# Float mode (the live path): Float's bot pays the coin's creator share into HOT_WALLET's token account for the paired
# token; the worker only sweeps it to SOL and credits the card fund. Replaces every pump.fun setting below.
FLOAT_FEES=no
# FLOAT_PAIR_MINT=CARDSccUMFKoPRZxt5vt3ksUbxEFEcnZ3H2pd3dKxYjp   # default is wrapped SOL
# Legacy pump.fun fee claimer: calls pump.fun's permissionless distribution so creator fees land in the vault.
# Needs SQUADS_VAULT_ADDRESS; refuses to claim unless the vault is a shareholder of the coin's fee-sharing config.
PUMP_COIN_MINT=
FEE_CLAIMER_SECRET_KEY=
FEE_CLAIM_MIN_BASE_UNITS=1
# One-wallet mode: HOT_WALLET_SECRET_KEY is also the coin's creator. It claims its own creator fees
# (PUMP_COIN_MINT, no FEE_CLAIMER_SECRET_KEY, no vault), swaps them to SOL if the coin is paired with a
# token, and adds FEE_CARD_FUND_BPS of the SOL value to the card fund. Off by default.
ONE_WALLET_FEES=no
FEE_SWAP_SLIPPAGE_BPS=100
FEE_SWAP_MAX_IMPACT_BPS=300
# Sweep every 10 minutes (FEE_CLAIM_INTERVAL_MS=600000, the minimum). Skip sweeps worth under about $1:
# in base units of the paired token (CARDS has 6 decimals, about $0.24 each, so 4000000 is about $1; wrapped SOL has 9 decimals).
FEE_SWAP_MIN_BASE_UNITS=4000000
# One-wallet mode for the card buyer: spends the wallet's own SOL, no Squads spending limit.
ONE_WALLET_BUYER=no
# Refuse to claim unless the vault gets at least this share of the fees (10000 = 100%).
FEE_MIN_VAULT_SHARE_BPS=10000
# Share of each claim (priced in USD at claim time) added to the card fund the game pays prizes from.
# The rest stays in the vault. 7000 = 70%.
FEE_CARD_FUND_BPS=7000
# Float mode: swap this share of every sweep to USDC (that USDC is the card fund, credited dollar for dollar;
# FEE_CARD_FUND_BPS is then unused). The rest becomes SOL and stays in the wallet. 3000 = 30% USDC / 70% SOL. 0 = off.
FEE_USDC_SHARE_BPS=3000
# Card buyer: buys Collector Crypt marketplace cards (USDC, no API key) with the hot wallet, swapping SOL to USDC through Jupiter, funded by a Squads
# spending limit (scripts/add-spending-limit.ts). Needs SQUADS_MULTISIG_ADDRESS. Off when unset.
BUYER_SPENDING_LIMIT=
# The daily prize budget is one dollar number: the game gives away at most this much in cards per UTC day, then
# opens pay shards only. Keep it equal to LOTUS_MAX_CARD_VALUE_PER_DAY on the game server (Vercel).
# The buyer keeps BUY_STOCK_DAYS of it in stock (1 = one day's worth), split by BUY_TIER_MIX, and only ever spends
# fund cash. A card may not cost more than the daily budget. A tier with nothing it can afford passes its share down.
# Set the budget to 0 to size from the pool instead: pool / LOTUS_POOL_PAYOUT_DAYS.
LOTUS_MAX_CARD_VALUE_PER_DAY=500
LOTUS_POOL_PAYOUT_DAYS=14
BUY_STOCK_DAYS=1
BUY_TIER_MIX=common:45,uncommon:30,rare:20,grail:5
# Same bands as the game's tiers.
BUY_TIER_MIN_USD=common:0,uncommon:30,rare:75,grail:300
# Listings must carry every one of these traits (case-insensitive). Type=Card keeps merch out and
# Category=Pokemon (no accent) keeps the stock to Pokemon; a Category here is also sent to the listings API.
# The on-chain grade trait is called "The Grade" (BUY_GRADE_TRAIT).
BUY_REQUIRED_TRAITS=Type=Card;Category=Pokemon
# Required with the buyer: the verified Collector Crypt collection and update authority.
BUY_COLLECTION_ADDRESS=
BUY_UPDATE_AUTHORITY=
BUY_WEEKLY_MAX_SOL=20
BUY_VALUE_TRAIT=Insured Value
BUY_MAX_PRICE_TO_VALUE=1
BUY_MAX_SOL_PER_CARD=10
# Hard top on one card; the pool-based cap (one day's release) is usually lower.
BUY_MAX_USD_PER_CARD=1000
# Where listings come from: api (website API) or chain (the marketplace program's accounts, then DAS traits).
BUY_LISTING_SOURCE=api
BUY_CHAIN_LISTING_LIMIT=300
BUY_SWAP_SLIPPAGE_BPS=100
BUY_MAX_CARDS_PER_TICK=10
MAGIC_EDEN_API_KEY=
