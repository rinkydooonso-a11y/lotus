# Lotus workers. Names only; real values come from the host's secret store, never from a committed file.
DATABASE_URL=
# Helius devnet RPC URL (also serves DAS). e.g. https://devnet.helius-rpc.com/?api-key=...
SOLANA_RPC_URL=
# Optional, defaults to SOLANA_RPC_URL
HELIUS_DAS_URL=
# Optional: Squads vault address (the vault, not the multisig account). Read-only; lets inventory sync check vault cards.
SQUADS_VAULT_ADDRESS=
# Hot wallet secret key (base58 or solana-keygen JSON array). Secret store only.
HOT_WALLET_SECRET_KEY=
# Leave unset. Mainnet is refused unless this equals the phrase in src/config.ts, set by a human at go-live.
LOTUS_ALLOW_MAINNET=
# Comma-separated Collector Crypt collection addresses counted as prize inventory (empty = all NFTs in the hot wallet)
PRIZE_COLLECTIONS=
PRIZE_SENDER_INTERVAL_MS=5000
PRIZE_SENDER_BATCH=10
PRIZE_SENDER_MAX_ATTEMPTS=8
INVENTORY_SYNC_INTERVAL_MS=120000
PRIORITY_FEE_MICROLAMPORTS=10000
