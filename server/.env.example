# Postgres with PostGIS (e.g. Supabase connection string). Never commit the real value.
DATABASE_URL=
# Optional, default 10
PG_POOL_MAX=

# Game dials. See docs/odds.md for what each one costs per day.
# Active crates kept alive in each launch city (default 60)
LOTUS_CRATES_PER_CITY=
# Hard ceiling on crates created per UTC day, across every city (default 1500)
LOTUS_MAX_CRATES_PER_DAY=
# How long a crate stays on the map, minutes (default 720)
LOTUS_CRATE_TTL_MIN=
# Closest two active crates may be, metres (default 120)
LOTUS_CRATE_SPACING_M=
# How far crates are sent to a player's map, metres (default 2000)
LOTUS_NEARBY_RADIUS_M=
# Free opens per player per UTC day; further opens that day cost a ticket (default 10)
LOTUS_FREE_OPENS_PER_DAY=
# Prize pool: a day pays out at most (card fund cash + cost of cards in stock) / this many days,
# released evenly over the 24 hours (default 14). Keep it equal to LOTUS_POOL_PAYOUT_DAYS on the workers.
LOTUS_POOL_PAYOUT_DAYS=
# Sanity stop on cards per day for a pool of cheap cards (default 1000). The pool is the real limit.
LOTUS_MAX_CARDS_PER_DAY=
# Emergency dial only: a fixed dollar ceiling that replaces the pool-based one (default 0 = off).
LOTUS_MAX_CARD_VALUE_PER_DAY=

# Coin holder gate. Dormant until a coin address is set: with none there is no requirement and every
# open goes through. NEXT_PUBLIC_COIN_ADDRESS (what the site shows) switches it on too, so launch day
# is one setting. SOLANA_RPC_URL reads balances; unset, it falls back to the rate limited public RPC.
COIN_MINT=
SOLANA_RPC_URL=
# USD of the coin a wallet must hold to open a crate (default 25)
LOTUS_HOLD_REQUIRED_USD=
# How long a qualifying check stands for, hours. The coin amount is fixed for this long (default 48)
LOTUS_HOLD_WINDOW_HOURS=
# Inside a window, how stale a balance may be before it is read again, minutes (default 10)
LOTUS_HOLD_RECHECK_MIN=
# Price feed. Defaults to Jupiter's public price API
COIN_PRICE_URL=
# Set to off to switch the holder gate off even with a coin address set
LOTUS_HOLD_GATE=

# Set to off to let crates be read outside the launch cities (testing)
LOTUS_CITY_GATE=
