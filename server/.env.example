# Postgres with PostGIS (e.g. Supabase connection string). Never commit the real value.
DATABASE_URL=
# Optional, default 10
PG_POOL_MAX=
# Optional: comma-separated Overpass endpoints for walkable spawns (default: public overpass-api.de + kumi mirror)
OVERPASS_URLS=
# Optional: set to off to skip OpenStreetMap and always use the short-nudge spawn
WALKABLE_SPAWNS=
