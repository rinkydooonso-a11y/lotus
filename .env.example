# =============================================================================
# Lotus: every environment variable across web, server, anticheat, workers.
# Names only. Never commit real values. Real values go in:
#   - local dev: web/.env.local and workers/.env (both gitignored)
#   - production: Vercel (web) and Fly (workers) environment settings
# "Used by": WEB = Vercel project, WORKERS = Fly app lotus-workers (fly secrets set), MIGRATE = run once from your laptop.
# =============================================================================

# ---- Database (Supabase) ----------------------------------------------------
# Used by: WEB, WORKERS, MIGRATE.
# Supabase Postgres with PostGIS. Supabase dashboard > Project Settings > Database > Connection string.
# Use the "Session pooler" string (port 5432) for WORKERS and MIGRATE (long-lived, advisory locks need it).
# Use the "Transaction pooler" string (port 6543) for WEB on Vercel (many short serverless connections).
# Before the first migration run: Supabase > Database > Extensions > enable "postgis".
DATABASE_URL=
# Optional (default 10). Keep low (3-5) for WEB on Vercel.
PG_POOL_MAX=

# ---- Web session and admin (WEB) --------------------------------------------
# Signs the login cookie. Required in production. Generate: openssl rand -base64 48
LOTUS_SESSION_SECRET=
# Comma-separated wallet addresses allowed into /admin (your own wallet public address).
LOTUS_ADMIN_WALLETS=
# 1 = in-memory stub (demo, no database). 0 = real game via DATABASE_URL. Set to 0 in production.
LOTUS_USE_STUB=0
# devnet for the first deploy. Switch to mainnet-beta only at go-live (see docs/launch-runbook.md).
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
# Optional map style URL (MapLibre style JSON). Empty = free OpenStreetMap raster tiles.
# Fine for a launch test; for real traffic use MapTiler or Stadia (they have free tiers) to avoid OSM's usage limits.
NEXT_PUBLIC_MAP_STYLE_URL=

# ---- Anti-cheat: Upstash Redis (WEB) ----------------------------------------
# console.upstash.com > create a Redis database > REST API section.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Helius (WEB for anti-cheat wallet checks, WORKERS for sending) -----------
# dashboard.helius.dev > API key. Devnet first: https://devnet.helius-rpc.com/?api-key=YOUR_KEY
# WEB: optional, enables wallet-age and funder signals in anti-cheat.
HELIUS_RPC_URL=
# WORKERS: required. Same Helius URL (it serves normal RPC and DAS).
SOLANA_RPC_URL=
# WORKERS: optional, defaults to SOLANA_RPC_URL.
HELIUS_DAS_URL=

# Optional: direct (non-pooler) Supabase connection used only for the prize-sender lock,
# e.g. postgresql://postgres:PASSWORD@db.<ref>.supabase.co:5432/postgres. Falls back to DATABASE_URL.
DATABASE_LOCK_URL=

# ---- Workers: hot wallet and prize inventory (WORKERS only) -----------------
# The wallet that holds the prize NFTs and signs sends. Base58 secret key or the solana-keygen JSON array.
# Use a brand-new wallet used for nothing else. Put it ONLY in Fly secrets.
HOT_WALLET_SECRET_KEY=
# Leave EMPTY until mainnet go-live. The worker refuses mainnet unless this equals the phrase in workers/src/config.ts.
LOTUS_ALLOW_MAINNET=
# Comma-separated Collector Crypt collection addresses to count as prize inventory (empty = every NFT in the hot wallet).
PRIZE_COLLECTIONS=
PRIZE_SENDER_INTERVAL_MS=5000
PRIZE_SENDER_BATCH=10
PRIZE_SENDER_MAX_ATTEMPTS=8
INVENTORY_SYNC_INTERVAL_MS=120000
PRIORITY_FEE_MICROLAMPORTS=10000

# ---- Walkable crate spawns (WEB, both optional) -----------------------------
# Crates are placed on footpaths/parks using OpenStreetMap data via the Overpass API.
# Comma-separated Overpass endpoints. Empty = two free public mirrors (rate limited, fine for testing).
# Before launch traffic, point this at your own or a paid Overpass instance.
OVERPASS_URLS=
# Set to "off" to disable the lookup (crates then spawn without the walkable check).
WALKABLE_SPAWNS=

# ---- Anti-cheat threshold overrides (WEB, all optional) ---------------------
# Defaults live in server/anticheat/config.ts. Leave blank unless tuning.
LOTUS_AC_MAX_OPEN_DISTANCE_M=
LOTUS_AC_MAX_ACCURACY_M=
LOTUS_AC_MAX_SPEED_MPS=
LOTUS_AC_TELEPORT_DISTANCE_M=
LOTUS_AC_MAX_LAST_PING_AGE_MS=
LOTUS_AC_MAX_CLOCK_SKEW_MS=
LOTUS_AC_ANCHOR_RESET_MS=
LOTUS_AC_MAX_PINGS_PER_SCAN=
LOTUS_AC_MOVEMENT_STRIKES_TO_FLAG=
LOTUS_AC_WALLET_COOLDOWN_S=
LOTUS_AC_DEVICE_COOLDOWN_S=
LOTUS_AC_WALLET_DAILY_CAP=
LOTUS_AC_DEVICE_DAILY_CAP=
LOTUS_AC_REQUESTS_PER_MINUTE=
LOTUS_AC_MAX_WALLETS_PER_DEVICE=
LOTUS_AC_MAX_WALLETS_PER_IP=
LOTUS_AC_MAX_WALLETS_PER_FUNDER=
LOTUS_AC_MIN_WALLET_AGE_H=
LOTUS_AC_SYBIL_FLAG_SCORE=
LOTUS_AC_SYBIL_BLOCK_SCORE=
LOTUS_AC_FLAG_DEDUPE_S=
LOTUS_AC_WALLET_LOOKUP_TIMEOUT_MS=
LOTUS_AC_KEY_PREFIX=

# ---- Health check (WEB, both optional) -------------------------------------
# GET /api/health returns 503 when the worker has not written a vault snapshot, or a prize has sat queued, longer than this.
HEALTH_WORKER_MAX_AGE_S=900
HEALTH_QUEUE_MAX_AGE_S=900

# ---- Workers: treasury (WORKERS, all optional; each job starts only when its keys are set) ----
# Read-only Squads vault address (the vault, not the multisig account).
SQUADS_VAULT_ADDRESS=
# Top-up proposer: drafts Squads proposals moving vault cards and SOL to the hot wallet.
SQUADS_MULTISIG_ADDRESS=
SQUADS_PROPOSER_SECRET_KEY=
SQUADS_MIN_THRESHOLD=2
TOPUP_TARGETS=common:10,uncommon:4,rare:2,grail:1
TOPUP_MAX_CARDS=10
TOPUP_MAX_USD=500
TOPUP_MIN_HOT_SOL=0.05
TOPUP_SOL_AMOUNT=0.1
# Fee claimer: runs pump.fun's permissionless fee distribution so creator fees reach the vault.
PUMP_COIN_MINT=
FEE_CLAIMER_SECRET_KEY=
FEE_CLAIM_MIN_BASE_UNITS=1
FEE_MIN_VAULT_SHARE_BPS=10000
# Ping retention: location pings older than this are deleted hourly.
PING_RETENTION_DAYS=30
# The card auto-buyer (BUY_* variables, BUYER_SPENDING_LIMIT) is added by PR #8; document them in this file when it merges.
