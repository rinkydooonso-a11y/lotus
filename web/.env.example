# Session cookie signing (required in production)
LOTUS_SESSION_SECRET=
# Comma-separated wallet addresses allowed into /admin
LOTUS_ADMIN_WALLETS=
# Public: Solana cluster for wallet adapter (devnet only for now)
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
# Public: map tile style URL (defaults to OpenStreetMap raster tiles)
NEXT_PUBLIC_MAP_STYLE_URL=
# Set to 0 (with DATABASE_URL set) to use lotus/server instead of the in-memory stub
LOTUS_USE_STUB=1
DATABASE_URL=
# Public: the coin address shown across the site. Setting it also switches the coin holder gate on
# (the API routes read it too), so this one value is all launch day needs. Until then there is no
# coin requirement and every open goes through. See server/.env.example for the other dials.
NEXT_PUBLIC_COIN_ADDRESS=
# Reads coin balances for the gate. Set it for real traffic; unset falls back to the public RPC.
SOLANA_RPC_URL=
